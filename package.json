{
  "name": "miogames-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "MIO Games vertical slice: multi-tenant casino gamification (deposit-triggered wheel, coin ledger, bonus store, reward delivery)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.20",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:migrate:seed": "node --env-file-if-exists=.env dist/db/migrate.js --seed",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "demo": "node scripts/demo.mjs"
  }
}

# Copy to .env to run the API on the host against the compose Postgres:
#   docker compose up -d postgres && npm run build && npm run db:migrate:seed && npm start
# npm scripts load .env automatically (node --env-file-if-exists).
PORT=3100
DATABASE_URL=postgres://mio:mio@localhost:5433/mio
MOCK_CASINO_URL=http://localhost:4100
LOG_LEVEL=info
SPIN_SEED_SECRET=local-dev-spin-seed-secret-change-me-0123

# Test suite (npm test) uses a separate database created by docker/postgres-init.
TEST_DATABASE_URL=postgres://mio:mio@localhost:5433/mio_test
